#include <stdio.h>

#define AGING_THRESHOLD 15

int main() {
    int n;
    printf("Enter number of processes: ");
    scanf("%d", &n);

    int pid[n], at[n], bt[n], ct[n], tat[n], wt[n], completed[n];

    for (int i = 0; i < n; i++) {
        pid[i] = i + 1;
        printf("Enter Arrival Time and Burst Time for Process %d: ", pid[i]);
        scanf("%d %d", &at[i], &bt[i]);
        completed[i] = 0;
    }

    int time = 0, completedCount = 0;

    while (completedCount < n) {
        int idx = -1;
        int min_bt = 9999;

        // Aging condition
        for (int i = 0; i < n; i++) {
            if (at[i] <= time && completed[i] == 0) {
                int waiting = time - at[i];
                if (waiting > AGING_THRESHOLD) {
                    idx = i;
                    break;
                }
            }
        }

        // Shortest Job First
        if (idx == -1) {
            for (int i = 0; i < n; i++) {
                if (at[i] <= time && completed[i] == 0) {
                    if (bt[i] < min_bt) {
                        min_bt = bt[i];
                        idx = i;
                    }
                }
            }
        }

        // If no process available
        if (idx == -1) {
            time++;
        } else {
            time += bt[idx];
            ct[idx] = time;
            completed[idx] = 1;
            completedCount++;
        }
    }

    float totalWT = 0, totalTAT = 0;

    for (int i = 0; i < n; i++) {
        tat[i] = ct[i] - at[i];
        wt[i] = tat[i] - bt[i];
        totalWT += wt[i];
        totalTAT += tat[i];
    }

    int totalTime = 0;
    for (int i = 0; i < n; i++) {
        if (ct[i] > totalTime)
            totalTime = ct[i];
    }

    float throughput = (float)n / totalTime;

    // ===== Table Output =====
    printf("\n====================================================");
    printf("\nPID\tAT\tBT\tCT\tTAT\tWT");
    printf("\n====================================================");

    for (int i = 0; i < n; i++) {
        printf("\nP%d\t%d\t%d\t%d\t%d\t%d",
               pid[i], at[i], bt[i], ct[i], tat[i], wt[i]);
    }

    printf("\n====================================================\n");

    // ===== Final Results =====
    printf("\nTotal Waiting Time = %.2f\n", totalWT);
    printf("Average Waiting Time = %.2f\n", totalWT / n);

    printf("Total Turnaround Time = %.2f\n", totalTAT);
    printf("Average Turnaround Time = %.2f\n", totalTAT / n);

    printf("Throughput = %.3f processes/unit time\n", throughput);

    return 0;
}
