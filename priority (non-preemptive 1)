#include <stdio.h>

int main() {
    int n, i, time = 0, completed = 0;
    int p[20], at[20], bt[20], pr[20];
    int ct[20], tat[20], wt[20];
    int done[20] = {0};

    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("\nEnter Arrival Time, Burst Time, Priority (single line)\n");
    printf("Format: AT BT PR\n\n");

    for (i = 0; i < n; i++) {
        p[i] = i + 1;
        printf("P%d: ", p[i]);
        scanf("%d %d %d", &at[i], &bt[i], &pr[i]);
    }

    printf("\n--- Priority Scheduling (Non-Preemptive) ---\n");

    while (completed < n) {
        int idx = -1;
        int highestPriority = 9999;

        for (i = 0; i < n; i++) {
            if (at[i] <= time && done[i] == 0) {
                if (pr[i] < highestPriority) {
                    highestPriority = pr[i];
                    idx = i;
                }
            }
        }

        if (idx != -1) {
            time += bt[idx];
            ct[idx] = time;
            tat[idx] = ct[idx] - at[idx];
            wt[idx] = tat[idx] - bt[idx];
            done[idx] = 1;
            completed++;
        } else {
            time++;
        }
    }

    int totalTAT = 0, totalWT = 0;

    printf("P\tAT\tBT\tPR\tCT\tTAT\tWT\n");
    for (i = 0; i < n; i++) {
        totalTAT += tat[i];
        totalWT += wt[i];
        printf("P%d\t%d\t%d\t%d\t%d\t%d\t%d\n",
               p[i], at[i], bt[i], pr[i], ct[i], tat[i], wt[i]);
    }

    printf("\nTotal Turnaround Time = %d", totalTAT);
    printf("\nAverage Turnaround Time = %.2f", (float)totalTAT / n);
    printf("\nTotal Waiting Time = %d", totalWT);
    printf("\nAverage Waiting Time = %.2f\n", (float)totalWT / n);

    return 0;
}
