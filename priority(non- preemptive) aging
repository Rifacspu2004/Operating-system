#include <stdio.h>

#define AGING_INTERVAL 5  

int main() {
    int n;
    printf("Enter number of processes: ");
    scanf("%d", &n);

    int pid[n], at[n], bt[n], pri[n], initial_pri[n], ct[n], tat[n], wt[n], completed[n];

    // Single-line input: AT BT Initial Priority
    for (int i = 0; i < n; i++) {
        pid[i] = i + 1;
        printf("Enter Arrival Time, Burst Time, and Initial Priority (Lower = Higher) for P%d: ", pid[i]);
        scanf("%d %d %d", &at[i], &bt[i], &pri[i]);
        initial_pri[i] = pri[i]; 
        completed[i] = 0;
    }

    int time = 0, completedCount = 0;

    while (completedCount < n) {
        int idx = -1;
        int highest_priority = 9999;

        // Update priorities using aging
        for (int i = 0; i < n; i++) {
            if (at[i] <= time && !completed[i]) {
                int wait_time = time - at[i];
                int aged_priority = initial_pri[i] - (wait_time / AGING_INTERVAL);
                if (aged_priority < 0) aged_priority = 0;
                pri[i] = aged_priority; 
            }
        }

        // Find highest priority process
        for (int i = 0; i < n; i++) {
            if (at[i] <= time && !completed[i]) {
                if (pri[i] < highest_priority) {
                    highest_priority = pri[i];
                    idx = i;
                } else if (pri[i] == highest_priority) {
                    if (at[i] < at[idx]) {
                        idx = i;
                    }
                }
            }
        }

        if (idx == -1) {
            time++; 
        } else {
            time += bt[idx];
            ct[idx] = time;
            completed[idx] = 1;
            completedCount++;
        }
    }

    float totalWT = 0, totalTAT = 0;
    int maxCompletionTime = 0;

    // Table Output
    printf("\n=================================================================\n");
    printf("PID\tAT\tBT\tOrigPri\tFinalPri\tCT\tTAT\tWT\n");
    printf("=================================================================\n");

    for (int i = 0; i < n; i++) {
        tat[i] = ct[i] - at[i];
        wt[i] = tat[i] - bt[i];
        totalWT += wt[i];
        totalTAT += tat[i];

        if (ct[i] > maxCompletionTime) maxCompletionTime = ct[i];

        printf("P%d\t%d\t%d\t%d\t%d\t\t%d\t%d\t%d\n", 
               pid[i], at[i], bt[i], initial_pri[i], pri[i], ct[i], tat[i], wt[i]);
    }
    printf("=================================================================\n");

    // Total and Average Waiting/Turnaround Time
    printf("Total Waiting Time = %.2f\n", totalWT);
    printf("Average Waiting Time = %.2f\n", totalWT / n);
    printf("Total Turnaround Time = %.2f\n", totalTAT);
    printf("Average Turnaround Time = %.2f\n", totalTAT / n);

    float throughput = (float)n / maxCompletionTime;
    printf("Throughput = %.4f processes/unit time\n", throughput);

    return 0;
}
