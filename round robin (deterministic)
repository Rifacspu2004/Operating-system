#include <stdio.h>

int main() {
    int n, tq;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("Enter time quantum: ");
    scanf("%d", &tq);

    int at[n], bt[n];
    int rt[n], ct[n], tat[n], wt[n];
    int queue[100], front = 0, rear = 0;
    int visited[n];

    int time = 0, completed = 0;
    float totalWT = 0, totalTAT = 0;

    // Input Arrival Time and Burst Time
    for (int i = 0; i < n; i++) {
        printf("Enter Arrival Time and Burst Time for P%d: ", i + 1);
        scanf("%d %d", &at[i], &bt[i]);
        rt[i] = bt[i];
        visited[i] = 0;
    }

    // Push initially arrived processes
    for (int i = 0; i < n; i++) {
        if (at[i] == 0) {
            queue[rear++] = i;
            visited[i] = 1;
        }
    }

    while (completed < n) {

        if (front == rear) {
            time++;
            for (int i = 0; i < n; i++) {
                if (at[i] <= time && !visited[i]) {
                    queue[rear++] = i;
                    visited[i] = 1;
                }
            }
            continue;
        }

        int p = queue[front++];

        if (rt[p] > tq) {
            rt[p] -= tq;
            time += tq;
        } else {
            time += rt[p];
            rt[p] = 0;
            ct[p] = time;
            completed++;
        }

        for (int i = 0; i < n; i++) {
            if (at[i] <= time && !visited[i]) {
                queue[rear++] = i;
                visited[i] = 1;
            }
        }

        if (rt[p] > 0)
            queue[rear++] = p;
    }

    printf("\nProcess\tAT\tBT\tCT\tTAT\tWT\n");

    for (int i = 0; i < n; i++) {
        tat[i] = ct[i] - at[i];
        wt[i] = tat[i] - bt[i];

        totalWT += wt[i];
        totalTAT += tat[i];

        printf("P%d\t%d\t%d\t%d\t%d\t%d\n",
               i + 1, at[i], bt[i], ct[i], tat[i], wt[i]);
    }

    printf("\nAverage Waiting Time = %.2f", totalWT / n);
    printf("\nAverage Turnaround Time = %.2f\n", totalTAT / n);

    return 0;
}
