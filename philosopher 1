#include <iostream>
#include <thread>
#include <mutex>
#include <vector>
#include <chrono>
#include <condition_variable>

using namespace std;

const int N = 5;

// Forks (mutexes)
mutex forks[N];

// Semaphore simulation (N-1 rule)
int count_allowed = N - 1;
mutex mtx;
condition_variable cv;

// Mutex for clean output
mutex print_mutex;

// Take permission (N-1 philosophers rule)
void take_permission() {
    unique_lock<mutex> lock(mtx);
    while (count_allowed == 0) {
        cv.wait(lock);
    }
    count_allowed--;
}

// Release permission
void release_permission() {
    unique_lock<mutex> lock(mtx);
    count_allowed++;
    cv.notify_one();
}

// Philosopher function (LEFT = (id+1)%N, RIGHT = id)
void philosopher(int id) {
    int right = id;
    int left  = (id + 1) % N;

    for (int i = 0; i < 2; i++) {  // limited loops for clean output
        // Thinking
        {
            lock_guard<mutex> lock(print_mutex);
            cout << "Philosopher " << id << " is thinking\n";
        }
        this_thread::sleep_for(chrono::milliseconds(500));

        // Hungry
        {
            lock_guard<mutex> lock(print_mutex);
            cout << "Philosopher " << id << " is hungry\n";
        }

        // N-1 semaphore
        take_permission();

        // Pick LEFT fork first
        forks[left].lock();
        {
            lock_guard<mutex> lock(print_mutex);
            cout << "Philosopher " << id << " picked LEFT fork\n";
        }
        this_thread::sleep_for(chrono::milliseconds(200));

        // Pick RIGHT fork second
        forks[right].lock();
        {
            lock_guard<mutex> lock(print_mutex);
            cout << "Philosopher " << id << " picked RIGHT fork\n";
        }

        // Eating
        {
            lock_guard<mutex> lock(print_mutex);
            cout << "Philosopher " << id << " is eating\n";
        }
        this_thread::sleep_for(chrono::milliseconds(500));

        // Release forks
        forks[left].unlock();
        forks[right].unlock();

        // Release semaphore
        release_permission();

        {
            lock_guard<mutex> lock(print_mutex);
            cout << "Philosopher " << id << " finished eating\n\n";
        }
        this_thread::sleep_for(chrono::milliseconds(300));
    }
}

int main() {
    vector<thread> philosophers;

    // Start philosopher threads
    for (int i = 0; i < N; i++) {
        philosophers.emplace_back(philosopher, i);
        this_thread::sleep_for(chrono::milliseconds(100)); // stagger start
    }

    // Join threads
    for (auto &t : philosophers) {
        t.join();
    }

    cout << "Simulation finished.\n";
    return 0;
}
