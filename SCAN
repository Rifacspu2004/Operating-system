#include <stdio.h>
#include <stdlib.h>
#include <math.h>

void sort(int arr[], int n) {
    for(int i = 0; i < n-1; i++)
        for(int j = 0; j < n-i-1; j++)
            if(arr[j] > arr[j+1]) {
                int t = arr[j];
                arr[j] = arr[j+1];
                arr[j+1] = t;
            }
}

int main() {
    int n, head, disk_size, direction, seek = 0;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    int req[n+1];
    printf("Enter request sequence: ");
    for(int i = 0; i < n; i++)
        scanf("%d", &req[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter disk size: ");
    scanf("%d", &disk_size);

    printf("Enter direction (1=right, 0=left): ");
    scanf("%d", &direction);

    req[n] = (direction == 1) ? disk_size - 1 : 0;
    n++;

    sort(req, n);

    int pos;
    for(int i = 0; i < n; i++)
        if(req[i] >= head) { pos = i; break; }

    printf("\nSeek Sequence: %d ", head);

    if(direction == 1) {
        for(int i = pos; i < n; i++) {
            seek += abs(req[i] - head);
            head = req[i];
            printf("-> %d ", head);
        }
        for(int i = pos-1; i >= 0; i--) {
            seek += abs(req[i] - head);
            head = req[i];
            printf("-> %d ", head);
        }
    } else {
        for(int i = pos-1; i >= 0; i--) {
            seek += abs(req[i] - head);
            head = req[i];
            printf("-> %d ", head);
        }
        for(int i = pos; i < n; i++) {
            seek += abs(req[i] - head);
            head = req[i];
            printf("-> %d ", head);
        }
    }

    printf("\nTotal Seek Time: %d\n", seek);
    return 0;
}

