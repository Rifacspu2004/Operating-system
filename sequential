#include <stdio.h>
#define MAX 50

int main() {
    int memory[MAX] = {0};
    int n, start, length, i, j, flag;

    printf("===== SEQUENTIAL FILE ALLOCATION =====\n");
    printf("Enter number of files: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("\nEnter starting block & length of file %d: ", i + 1);
        scanf("%d %d", &start, &length);

        flag = 0;

        // Check if blocks are available
        for (j = start; j < start + length; j++) {
            if (j >= MAX || memory[j] == 1) {
                flag = 1;
                break;
            }
        }

        // Allocate if flag is 0
        if (flag == 0) {
            for (j = start; j < start + length; j++) {
                memory[j] = 1;
            }
            printf("File %d allocated successfully.\n", i + 1);
        } else {
            printf("File %d cannot be allocated.\n", i + 1);
        }
    }

    // Display memory block status
    printf("\nMemory Block Status:\n");
    for (i = 0; i < MAX; i++) {
        printf("[%2d:%s] ", i, memory[i] ? "X" : "F");
        if ((i + 1) % 10 == 0) printf("\n");
    }
    printf("\n");

    return 0;
}
