#include <stdio.h>

#define MAX_BLOCKS 50

int disk[MAX_BLOCKS];

int main() {
    int start, length, i;

    for (i = 0; i < MAX_BLOCKS; i++) disk[i] = 0;

    printf("===== SEQUENTIAL FILE ALLOCATION =====\n");
    printf("Enter starting block: ");
    scanf("%d", &start);
    printf("Enter number of blocks needed: ");
    scanf("%d", &length);

    // Check availability
    for (i = start; i < start + length; i++) {
        if (i >= MAX_BLOCKS) { printf("Exceeds disk size!\n"); return 0; }
        if (disk[i] == 1) { printf("Block %d already occupied!\n", i); return 0; }
    }

    // Allocate
    for (i = start; i < start + length; i++) disk[i] = 1;

    printf("\nFile allocated successfully!\n");
    printf("\nStart Block\tLength\tBlocks Allocated\n");
    printf("%d\t\t%d\t", start, length);
    for (i = start; i < start + length; i++) printf("%d ", i);
    printf("\n");

    printf("\nDisk Status (F=Free, X=Occupied):\n");
    for (i = 0; i < MAX_BLOCKS; i++) {
        printf("[%2d:%s] ", i, disk[i] ? "X" : "F");
        if ((i + 1) % 10 == 0) printf("\n");
    }
    printf("\n");

    return 0;
}
